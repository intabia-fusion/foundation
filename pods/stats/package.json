{
  "name": "@hcengineering/pod-stats",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "author": "Anticrm Platform Contributors",
  "template": "@hcengineering/node-package",
  "license": "EPL-2.0",
  "scripts": {
    "start": "ts-node src/__start.ts",
    "build": "compile",
    "build:watch": "compile",
    "_phase:bundle": "pnpm run bundle",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:docker-staging": "pnpm run docker:staging",
    "bundle": "node ../../common/scripts/esbuild.js --entry=src/__start.ts --keep-names=true --sourcemap=external --define=MODEL_VERSION --external=*.node --external=snappy",
    "docker:build": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_build.sh intabiafusion/stats",
    "docker:tbuild": "docker build -t intabiafusion/stats . --platform=linux/amd64 && ../../common/scripts/docker_tag_push.sh intabiafusion/stats",
    "docker:abuild": "docker build -t intabiafusion/stats . --platform=linux/arm64 && ../../common/scripts/docker_tag_push.sh intabiafusion/stats",
    "docker:staging": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/stats staging",
    "docker:push": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/stats",
    "format": "format src",
    "test": "jest --passWithNoTests --silent --forceExit",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent --forceExit",
    "_phase:format": "format src"
  },
  "devDependencies": {
    "cross-env": "catalog:",
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint": "catalog:",
    "esbuild": "catalog:",
    "@types/koa-router": "catalog:",
    "@types/koa": "catalog:",
    "@types/koa__cors": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "prettier": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "@types/jest": "catalog:",
    "eslint-config-standard": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "@stylistic/eslint-plugin": "catalog:"
  },
  "dependencies": {
    "@hcengineering/platform": "workspace:^0.7.19",
    "@hcengineering/core": "workspace:^0.7.24",
    "koa": "catalog:",
    "koa-router": "catalog:",
    "koa-body": "^7.0.1",
    "@koa/cors": "catalog:",
    "@hcengineering/server-token": "workspace:^0.7.17",
    "@hcengineering/server-core": "workspace:^0.7.18",
    "@hcengineering/rpc": "workspace:^0.7.17",
    "@hcengineering/analytics": "workspace:^0.7.17",
    "@hcengineering/analytics-service": "workspace:^0.7.17",
    "snappy": "catalog:"
  }
}
