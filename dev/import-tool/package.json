{
  "name": "@hcengineering/import-tool",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "author": "Anticrm Platform Contributors",
  "template": "@hcengineering/node-package",
  "license": "EPL-2.0",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "start": "ts-node src/__start.ts",
    "_phase:bundle": "pnpm run bundle",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:docker-staging": "pnpm run docker:staging",
    "bundle": "node ../../common/scripts/esbuild.js --entry=src/__start.ts --keep-names=true --define=MODEL_VERSION --define=GIT_REVISION --sourcemap=external",
    "docker:build": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_build.sh intabiafusion/import-tool",
    "docker:tbuild": "docker build -t intabiafusion/import-tool . --platform=linux/amd64 && node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag_push.sh intabiafusion/import-tool",
    "docker:staging": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/import-tool staging",
    "docker:push": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/import-tool",
    "run-local": "pnpm -w bundle --to @hcengineering/import-tool >/dev/null && cross-env SERVER_SECRET=secret ACCOUNTS_URL=http://localhost:3000 TRANSACTOR_URL=ws://localhost:3333 MINIO_ACCESS_KEY=minioadmin MINIO_SECRET_KEY=minioadmin MINIO_ENDPOINT=localhost MONGO_URL=mongodb://localhost:27017 TELEGRAM_DATABASE=telegram-service REKONI_URL=http://localhost:4004 MODEL_VERSION=$(node ../../common/scripts/show_version.js) GIT_REVISION=$(git describe --all --long) node --max-old-space-size=18000 ./bundle/bundle.js",
    "run-local-brk": "pnpm -w bundle --to @hcengineering/import-tool >/dev/null && cross-env SERVER_SECRET=secret ACCOUNTS_URL=http://localhost:3000 TRANSACTOR_URL=ws://localhost:3333 MINIO_ACCESS_KEY=minioadmin MINIO_SECRET_KEY=minioadmin MINIO_ENDPOINT=localhost MONGO_URL=mongodb://localhost:27017 TELEGRAM_DATABASE=telegram-service REKONI_URL=http://localhost:4004 MODEL_VERSION=$(node ../../common/scripts/show_version.js) GIT_REVISION=$(git describe --all --long) node --inspect-brk --enable-source-maps --max-old-space-size=18000 ./bundle/bundle.js",
    "run": "cross-env node --max-old-space-size=8000 ./bundle/bundle.js",
    "upgrade": "pnpm run run-local upgrade",
    "format": "format src",
    "test": "jest --passWithNoTests --silent --forceExit",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent --forceExit",
    "_phase:format": "format src"
  },
  "devDependencies": {
    "cross-env": "catalog:",
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "ts-node": "catalog:",
    "esbuild": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "typescript": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "@types/jest": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "prettier": "catalog:",
    "@types/js-yaml": "catalog:",
    "eslint-config-standard": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "@stylistic/eslint-plugin": "catalog:"
  },
  "dependencies": {
    "@hcengineering/core": "workspace:^0.7.24",
    "@hcengineering/platform": "workspace:^0.7.19",
    "@hcengineering/server-client": "workspace:^0.7.17",
    "@hcengineering/importer": "workspace:^0.7.0",
    "commander": "catalog:",
    "js-yaml": "catalog:",
    "mammoth": "catalog:"
  }
}
