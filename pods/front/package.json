{
  "name": "@hcengineering/pod-front",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "author": "Anticrm Platform Contributors",
  "template": "@hcengineering/node-package",
  "license": "EPL-2.0",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "_phase:bundle": "pnpm run bundle",
    "_phase:package": "pnpm run package",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:docker-staging": "pnpm run docker:staging",
    "bundle": "node ../../common/scripts/esbuild.js --entry=src/__start.ts --keep-names=true --define=MODEL_VERSION --define=VERSION --sourcemap=external --minify",
    "package": "node ../../common/scripts/run_in_bash.js \"rm -rf ./dist && cp -r ../../dev/prod/dist . && cp -r ../../dev/prod/public/* ./dist/ && rm ./dist/config.json\"",
    "docker:build": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_build.sh intabiafusion/front",
    "docker:staging": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/front staging",
    "docker:push": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/front",
    "docker:tbuild": "docker build -t intabiafusion/front . --platform=linux/amd64 && node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag_push.sh intabiafusion/front",
    "docker:abuild": "docker build -t intabiafusion/front . --platform=linux/arm64 && node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag_push.sh intabiafusion/front",
    "format": "format src",
    "run-local": "cross-env MINIO_ACCESS_KEY=minioadmin MINIO_SECRET_KEY=minioadmin MINIO_ENDPOINT=localhost SERVER_SECRET='secret' ACCOUNTS_URL=http://localhost:3000 UPLOAD_URL=/files MODEL_VERSION=$(node ../../common/scripts/show_version.js) VERSION=$(node ../../common/scripts/show_tag.js) PUBLIC_DIR='.' ts-node ./src/__start.ts",
    "test": "jest --passWithNoTests --silent --forceExit",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent --forceExit",
    "_phase:format": "format src"
  },
  "devDependencies": {
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "eslint": "catalog:",
    "@types/express": "catalog:",
    "@types/express-fileupload": "catalog:",
    "@types/uuid": "catalog:",
    "@types/cors": "catalog:",
    "esbuild": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "@types/body-parser": "catalog:",
    "cross-env": "catalog:",
    "ts-node": "catalog:",
    "@types/compression": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "@types/jest": "catalog:",
    "eslint-config-standard": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "@stylistic/eslint-plugin": "catalog:"
  },
  "dependencies": {
    "@hcengineering/prod": "workspace:^1.0.1",
    "@hcengineering/front": "workspace:^0.7.0",
    "@hcengineering/core": "workspace:^0.7.24",
    "@hcengineering/platform": "workspace:^0.7.19",
    "express": "catalog:",
    "express-fileupload": "catalog:",
    "uuid": "catalog:",
    "cors": "catalog:",
    "@hcengineering/server-core": "workspace:^0.7.18",
    "@hcengineering/server-token": "workspace:^0.7.17",
    "@hcengineering/attachment": "workspace:^0.7.0",
    "body-parser": "catalog:",
    "@hcengineering/analytics": "workspace:^0.7.17",
    "@hcengineering/analytics-service": "workspace:^0.7.17"
  }
}
