STORAGE_CONFIG="datalake|http://datalake:4031"
BACKUP_STORAGE_CONFIG="minio|minio?accessKey=minioadmin&secretKey=minioadmin"
BACKUP_BUCKET_NAME=ws-dev-backups
# Every region runs on the same postgres, each in its own database (see postgres-init/).
# America region
DB_URL=postgres://postgres:postgres@postgres:5433/region_main
# Europe region
DB_EU_URL=postgres://postgres:postgres@postgres:5433/region_europe
# Shared service database: account, billing, activity, datalake
DB_PG_URL=postgres://postgres:postgres@postgres:5433/postgres
# Used by docker-compose.cockroach.yaml, which moves the America region onto CockroachDB.
DB_COCKROACH_URL=postgresql://root@cockroach:26257/defaultdb?sslmode=disable
QUEUE_CONFIG=redpanda:9093
