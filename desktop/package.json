{
  "name": "@hcengineering/desktop",
  "version": "0.8.39",
  "main": "dist/main/electron.js",
  "template": "@hcengineering/webpack-package",
  "fastBuild": {
    "extraHashFiles": [
      "webpack.config.js",
      ".env"
    ]
  },
  "scripts": {
    "build": "compile",
    "build:watch": "tsc",
    "_phase:package": "pnpm run package",
    "_phase:test": "jest --passWithNoTests --silent --forceExit --detectOpenHandles",
    "package": "cross-env NODE_ENV=production NODE_OPTIONS='--max-old-space-size=4094' node ../common/scripts/set_model_and_version_env.js webpack --stats-error-details && echo 'done' ",
    "webpack": "cross-env NODE_ENV=development node ../common/scripts/set_model_and_version_env.js webpack --stats-error-details --progress -w",
    "devp": "cross-env NODE_ENV=production CLIENT_TYPE=dev node ../common/scripts/set_model_and_version_env.js webpack --progress -w",
    "dev": "cross-env NODE_ENV=development node ../common/scripts/set_model_and_version_env.js webpack --progress -w",
    "dev-build": "cross-env NODE_ENV=development node ../common/scripts/set_model_and_version_env.js webpack --stats-error-details",
    "start": "cross-env NODE_ENV=production node ../common/scripts/set_model_and_version_env.js electron --no-sandbox .",
    "start-dev": "cross-env NODE_ENV=development DEV_INSTANCE=true node ../common/scripts/set_model_and_version_env.js electron --no-sandbox .",
    "test": "jest --passWithNoTests --silent --forceExit --verbose --detectOpenHandles",
    "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand --no-cache",
    "format": "format src",
    "_phase:format": "format src"
  },
