    "_phase:docker-staging": "pnpm run docker:staging",
    "bundle": "echo done",
    "package": "echo done",
    "format": "echo done",
    "docker:build": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_build.sh intabiafusion/stream",
