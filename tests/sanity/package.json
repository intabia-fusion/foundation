{
  "name": "@hcengineering/tests-sanity",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "author": "Anticrm Platform Contributors",
  "template": "@hcengineering/default-package",
  "license": "EPL-2.0",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "_phase:build": "compile transpile tests",
    "_phase:test": "",
    "_phase:format": "format tests",
    "_phase:validate": "compile validate",
    "lint:fix": "eslint --fix tests",
    "lint": "eslint tests",
    "format": "format tests",
    "ci": "playwright install --with-deps chromium",
    "test": "",
    "uitest": "cross-env LOCAL_URL=http://localhost:8083/_account/ DEV_URL= playwright test -c ./tests/playwright.config.ts --grep-invert @llm",
    "uitest:telemetry": "telemetry/run.sh",
    "run-uitests": "cross-env LOCAL_URL=http://localhost:8083/_account/ DEV_URL= playwright test -c ./tests/playwright.config.ts --grep @llm",
    "staging-uitest": "cross-env PLATFORM_URI=https://front.hc.engineering/ playwright test -c ./tests/playwright.config.ts --grep @staging",
    "dev-uitest": "cross-env PLATFORM_URI=http://localhost:8080 PLATFORM_TRANSACTOR=ws://localhost:3332 WORKSPACE_REGION=cockroach DEV_URL=http://localhost:8080/account playwright test -c ./tests/playwright.config.ts",
    "debug": "cross-env LOCAL_URL=http://localhost:8083/_account/ DEV_URL= playwright test -c ./tests/playwright.config.ts --debug --headed",
    "dev-debug": "cross-env PLATFORM_URI=http://localhost:8080 PLATFORM_TRANSACTOR=ws://localhost:3332 WORKSPACE_REGION=cockroach playwright test -c ./tests/playwright.config.ts --debug --headed",
    "codegen": "playwright codegen --load-storage .auth/storage.json http://localhost:8083/workbench/sanity-ws/",
    "dev-codegen": "cross-env playwright codegen --load-storage storage-dev.json http://localhost:8080/workbench/sanity-ws/",
    "allure:generate": "allure generate allure-results -o allure-report --clean"
  },
  "devDependencies": {
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@types/jest": "^29.5.5",
    "@types/node": "^22.18.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-n": "^15.4.0",
    "eslint": "^8.54.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint-config-standard-with-typescript": "^40.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "@playwright/test": "^1.62.1",
    "allure-playwright": "^3.10.2",
    "allure-js-commons": "^3.10.2",
    "@faker-js/faker": "^8.4.1"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "cross-env": "~7.0.3",
    "@hcengineering/core": "workspace:^0.7.24",
    "@hcengineering/client-resources": "workspace:^0.7.18",
    "@hcengineering/account": "workspace:^0.7.0",
    "@hcengineering/account-client": "workspace:^0.7.21",
    "@hcengineering/server-token": "workspace:^0.7.17",
    "@hcengineering/api-client": "workspace:^0.7.18",
    "@hcengineering/love": "workspace:^0.7.0",
    "@hcengineering/tracker": "workspace:^0.7.0",
    "@hcengineering/task": "workspace:^0.7.0",
    "@hcengineering/rank": "workspace:^0.7.17",
    "pdf-parse": "~2.4.5"
  }
}
