{
  "name": "@hcengineering/pod-backup",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "author": "Anticrm Platform Contributors",
  "template": "@hcengineering/node-package",
  "license": "EPL-2.0",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "compile",
    "build:watch": "compile",
    "_phase:bundle": "pnpm run bundle",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:docker-staging": "pnpm run docker:staging",
    "get-model": "node ../../common/scripts/esbuild.js --entry=src/get-model.ts --out=get-model-bundle.js --keep-names=true --bundle=true --define=MODEL_VERSION --define=VERSION --define=GIT_REVISION && node ./bundle/get-model-bundle.js > ./bundle/model.json",
    "bundle": "pnpm run get-model && node ../../common/scripts/esbuild.js --entry=src/index.ts --keep-names=true --bundle=true --sourcemap=external --external=*.node",
    "docker:build": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_build.sh intabiafusion/backup",
    "docker:tbuild": "docker build -t intabiafusion/backup . --platform=linux/amd64 && node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag_push.sh intabiafusion/backup",
    "docker:abuild": "docker build -t intabiafusion/backup . --platform=linux/arm64 && node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag_push.sh intabiafusion/backup",
    "docker:staging": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/backup staging",
    "docker:push": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/backup",
    "run-local": "cross-env ACCOUNTS_URL=http://localhost:3000/ SECRET=secret MINIO_ACCESS_KEY=minioadmin MINIO_SECRET_KEY=minioadmin MINIO_ENDPOINT=localhost BUCKET_NAME=backups INTERVAL=30 ts-node src/index.ts",
    "format": "format src",
    "test": "jest --passWithNoTests --silent --forceExit",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent --forceExit",
    "_phase:format": "format src"
  },
  "devDependencies": {
    "cross-env": "catalog:",
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint": "catalog:",
    "esbuild": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "prettier": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "@types/jest": "catalog:",
    "@hcengineering/model-all": "workspace:^0.7.0",
    "eslint-config-standard": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "@stylistic/eslint-plugin": "catalog:"
  },
  "dependencies": {
    "@hcengineering/platform": "workspace:^0.7.19",
    "@hcengineering/server-token": "workspace:^0.7.17",
    "@hcengineering/server-core": "workspace:^0.7.18",
    "@hcengineering/server-pipeline": "workspace:^0.7.0",
    "@hcengineering/client": "workspace:^0.7.18",
    "@hcengineering/client-resources": "workspace:^0.7.18",
    "@hcengineering/core": "workspace:^0.7.24",
    "dotenv": "catalog:",
    "@hcengineering/backup-service": "workspace:^0.7.0",
    "@hcengineering/analytics": "workspace:^0.7.17",
    "@hcengineering/analytics-service": "workspace:^0.7.17",
    "@hcengineering/postgres": "workspace:^0.7.22"
  }
}
