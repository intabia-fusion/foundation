{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "declaration": true,
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "incremental": true,
    "types": ["node", "jest"],
    "isolatedModules": true
  }
}
