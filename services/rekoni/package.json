{
  "name": "@hcengineering/rekoni-service",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "author": "Anticrm Platform Contributors",
  "license": "UNLICENSED",
  "scripts": {
    "build": "compile",
    "_phase:bundle": "pnpm run bundle",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:docker-staging": "pnpm run docker:staging",
    "docker:build": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_build.sh intabiafusion/rekoni-service",
    "docker:tbuild": "docker build -t intabiafusion/rekoni-service . --platform=linux/amd64 && ../../common/scripts/docker_tag_push.sh intabiafusion/rekoni-service",
    "docker:abuild": "docker build -t intabiafusion/rekoni-service . --platform=linux/arm64 && ../../common/scripts/docker_tag_push.sh intabiafusion/rekoni-service",
    "docker:staging": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/rekoni-service staging",
    "docker:push": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/rekoni-service",
    "bundle": "node esbuild.js",
    "start": "ts-node-dev src/index.ts",
    "run-local": "cross-env ts-node src/index.ts",
    "check-ts": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "test": "jest --passWithNoTests --silent",
    "format": "format src",
    "find-skills": "ts-node ./src/find-skills.ts",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent",
    "_phase:format": "format src",
    "build:watch": "compile"
  },
  "devDependencies": {
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/html-to-text": "catalog:",
    "@types/node": "catalog:",
    "node-loader": "catalog:",
    "@types/body-parser": "catalog:",
    "@types/mime-types": "catalog:",
    "@types/express-form-data": "^2.0.5",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "@types/jest": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-node": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "ts-node": "catalog:",
    "ts-node-dev": "catalog:",
    "typescript": "catalog:",
    "esbuild": "catalog:",
    "eslint-plugin-n": "catalog:",
    "prettier": "catalog:",
    "@types/morgan": "catalog:",
    "eslint-config-standard": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "@stylistic/eslint-plugin": "catalog:"
  },
  "dependencies": {
    "@anticrm/skillset": "catalog:",
    "@hcengineering/core": "workspace:^0.7.24",
    "body-parser": "catalog:",
    "cors": "catalog:",
    "dotenv": "catalog:",
    "email-addresses": "catalog:",
    "express": "catalog:",
    "express-form-data": "^2.0.22",
    "html-to-text": "^9.0.3",
    "jimp": "^0.16.1",
    "jwt-simple": "catalog:",
    "libphonenumber-js": "catalog:",
    "mammoth": "catalog:",
    "mime-types": "catalog:",
    "pdfjs-dist": "2.12.313",
    "sharp": "catalog:",
    "morgan": "catalog:",
    "@hcengineering/server-core": "workspace:^0.7.18",
