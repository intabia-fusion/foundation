{
  "name": "@hcengineering/pod-server",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "author": "Anticrm Platform Contributors",
  "template": "@hcengineering/node-package",
  "license": "EPL-2.0",
  "scripts": {
    "start": "rush bundle --to @hcengineering/pod-server && cross-env NODE_ENV=production MODEL_VERSION=$(node ../../common/scripts/show_version.js) ACCOUNTS_URL=http://localhost:3000 REKONI_URL=http://localhost:4004 MONGO_URL=mongodb://localhost:27017 DB_URL=mongodb://localhost:27017 FRONT_URL=http://localhost:8087 UPLOAD_URL=/upload MINIO_ENDPOINT=localhost MINIO_ACCESS_KEY=minioadmin MINIO_SECRET_KEY=minioadmin METRICS_CONSOLE=true SERVER_SECRET=secret OPERATION_PROFILING=false MODEL_JSON=../../models/all/bundle/model.json STATS_URL=http://localhost:4900 node --inspect bundle/bundle.js",
    "start-cr": "rush bundle --to @hcengineering/pod-server && cross-env NODE_ENV=production MODEL_VERSION=$(node ../../common/scripts/show_version.js) ACCOUNTS_URL=http://localhost:3000 REKONI_URL=http://localhost:4004 DB_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable FRONT_URL=http://localhost:8087 UPLOAD_URL=/upload MINIO_ENDPOINT=localhost MINIO_ACCESS_KEY=minioadmin MINIO_SECRET_KEY=minioadmin METRICS_CONSOLE=true SERVER_SECRET=secret OPERATION_PROFILING=false MODEL_JSON=../../models/all/bundle/model.json STATS_URL=http://localhost:4900 FULLTEXT_URL=http://localhost:4702 SERVER_PORT=3332 node --inspect bundle/bundle.js",
    "start-flame": "rush bundle --to @hcengineering/pod-server && cross-env NODE_ENV=production MODEL_VERSION=$(node ../../common/scripts/show_version.js) ACCOUNTS_URL=http://localhost:3000 REKONI_URL=http://localhost:4004 MONGO_URL=mongodb://localhost:27017 FRONT_URL=http://localhost:8087 UPLOAD_URL=/upload MINIO_ENDPOINT=localhost MINIO_ACCESS_KEY=minioadmin MINIO_SECRET_KEY=minioadmin METRICS_CONSOLE=true SERVER_SECRET=secret MODEL_JSON=../../models/all/bundle/model.json clinic flame --dest ./out -- node --nolazy -r ts-node/register --enable-source-maps src/__start.ts",
    "start-raw": "ts-node src/__start.ts",
    "build": "compile",
    "_phase:bundle": "pnpm run bundle",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:docker-staging": "pnpm run docker:staging",
    "get-model": "node ../../common/scripts/esbuild.js --entry=src/get-model.ts --out=get-model-bundle.js --keep-names=true --define=MODEL_VERSION --define=VERSION --define=GIT_REVISION --bundle=true && node ./bundle/get-model-bundle.js > ./bundle/model.json",
    "bundle": "pnpm run get-model && node ../../common/scripts/esbuild.js --entry=src/__start.ts --keep-names=true --bundle=true --sourcemap=external --external=*.node --external=bufferutil --external=snappy --define=MODEL_VERSION --define=VERSION --define=GIT_REVISION --external=utf-8-validate --external=msgpackr-extract",
    "docker:build": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_build.sh intabiafusion/transactor",
    "docker:tbuild": "docker build -t intabiafusion/transactor . --platform=linux/amd64 && ../../common/scripts/docker_tag_push.sh intabiafusion/transactor",
    "docker:abuild": "docker build -t intabiafusion/transactor . --platform=linux/arm64 && ../../common/scripts/docker_tag_push.sh intabiafusion/transactor",
    "docker:staging": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/transactor staging",
    "docker:push": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/transactor",
    "build:watch": "compile",
    "format": "format src",
    "test": "jest --passWithNoTests --silent --forceExit",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent --forceExit",
    "_phase:format": "format src"
  },
  "devDependencies": {
    "cross-env": "catalog:",
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint": "catalog:",
    "@types/ws": "catalog:",
    "ts-node": "catalog:",
    "esbuild": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "@types/jest": "catalog:",
    "@hcengineering/model-all": "workspace:^0.7.0",
    "snappyjs": "catalog:",
    "@types/body-parser": "catalog:",
    "@types/morgan": "catalog:",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "eslint-config-standard": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "@stylistic/eslint-plugin": "catalog:"
  },
  "dependencies": {
    "@hcengineering/account-client": "workspace:^0.7.21",
    "@hcengineering/analytics": "workspace:^0.7.17",
    "@hcengineering/analytics-service": "workspace:^0.7.17",
    "@hcengineering/chunter": "workspace:^0.7.0",
    "@hcengineering/collaboration": "workspace:^0.7.17",
    "@hcengineering/contact": "workspace:^0.7.0",
    "@hcengineering/core": "workspace:^0.7.24",
    "@hcengineering/document": "workspace:^0.7.0",
    "@hcengineering/drive": "workspace:^0.7.0",
    "@hcengineering/kafka": "workspace:^0.7.19",
    "@hcengineering/middleware": "workspace:^0.7.22",
    "@hcengineering/minio": "workspace:^0.7.17",
    "@hcengineering/notification": "workspace:^0.7.0",
    "@hcengineering/platform": "workspace:^0.7.19",
    "@hcengineering/pod-notifications": "workspace:^0.7.0",
    "@hcengineering/pod-telegram-bot": "workspace:^0.7.0",
    "@hcengineering/postgres": "workspace:^0.7.22",
    "@hcengineering/preference": "workspace:^0.7.0",
    "@hcengineering/pulse": "workspace:^0.7.0",
    "@hcengineering/rpc": "workspace:^0.7.17",
    "@hcengineering/server": "workspace:^0.7.18",
    "@hcengineering/server-ai-bot": "workspace:^0.7.0",
    "@hcengineering/server-calendar": "workspace:^0.7.0",
    "@hcengineering/server-core": "workspace:^0.7.18",
    "@hcengineering/server-notification": "workspace:^0.7.0",
    "@hcengineering/server-pipeline": "workspace:^0.7.0",
    "@hcengineering/server-storage": "workspace:^0.7.17",
    "@hcengineering/server-telegram": "workspace:^0.7.0",
    "@hcengineering/server-token": "workspace:^0.7.17",
    "@hcengineering/task": "workspace:^0.7.0",
    "@hcengineering/text-core": "workspace:^0.7.18",
    "@hcengineering/text-markdown": "workspace:^0.7.20",
    "@hcengineering/tracker": "workspace:^0.7.0",
    "body-parser": "catalog:",
    "bufferutil": "catalog:",
    "cors": "catalog:",
    "express": "catalog:",
    "morgan": "catalog:",
    "msgpackr": "catalog:",
    "msgpackr-extract": "catalog:",
    "snappy": "catalog:",
    "utf-8-validate": "catalog:",
    "ws": "catalog:"
  }
}
