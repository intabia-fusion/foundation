{
  "name": "desktop",
  "version": "0.7.0",
  "main": "dist/main/electron.js",
  "author": "Intabia Fusion <platform@intabia.ru>",
  "template": "@hcengineering/default-package",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "_phase:package": "pnpm run package",
    "package": "rm -rf ./dist && cp -r ../desktop/dist . && cp ../desktop/.env ./dist && echo 'done'",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false NODE_ENV=production node ../common/scripts/set_model_and_version_env.js electron-builder build -p onTag",
    "dist-local": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false NODE_ENV=production node ../common/scripts/set_model_and_version_env.js electron-builder build",
    "dist-signed": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=true NODE_ENV=production node ../common/scripts/set_model_and_version_env.js electron-builder build -c.afterSign=scripts/notarize.js -p onTag",
    "dist-mac-win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false NODE_ENV=production node ../common/scripts/set_model_and_version_env.js electron-builder build --windows --x64",
    "format": "echo done",
    "bump": "bump-package-version",
    "bundle:server": "node ../common/scripts/esbuild.js --entry=src/server.ts --keep-names=true --sourcemap=external --minify",
    "dist-docker-build": "pnpm run bundle:server && node ../common/scripts/run_in_bash.js ../common/scripts/docker_build.sh intabiafusion/desktop-distro",
    "dist-docker-push": "pnpm run bundle:server && pnpm run docker:build && ../common/scripts/run_in_bash.js ../common/scripts/docker_tag.sh intabiafusion/desktop-distro",
    "test": "jest --forceExit",
    "verify-manifests": "node scripts/verify-manifests.js"
  },
  "devDependencies": {
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@hcengineering/desktop": "workspace:^0.8.0",
    "@vercel/webpack-asset-relocator-loader": "catalog:",
    "node-loader": "catalog:",
    "cross-env": "catalog:",
    "typescript": "catalog:",
    "electron": "catalog:",
    "@types/node": "catalog:",
    "electron-builder": "^26.16.0",
    "@electron/notarize": "^2.3.2",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "esbuild": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "@types/jest": "catalog:",
    "electron-updater": "catalog:",
    "ts-node": "catalog:",
    "eslint-config-standard": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "@stylistic/eslint-plugin": "catalog:"
  },
  "dependencies": {
    "electron-squirrel-startup": "catalog:",
    "dotenv": "catalog:",
    "js-yaml": "catalog:"
  },
  "homepage": "https://platform.intabia.ru",
  "productName": "Platform Desktop",
  "description": "Platform Desktop experience",
  "build": {
    "productName": "Platform",
    "appId": "intabia.Platform",
    "directories": {
      "output": "deploy"
    },
    "files": [
      "./dist/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "Platform-macos-${version}-${arch}.${ext}",
      "icon": "./src/AppIcon.icns",
      "hardenedRuntime": true,
      "entitlements": "./entitlements.mac.plist",
      "entitlementsInherit": "./entitlements.mac.plist",
      "notarize": false,
      "publish": {
        "provider": "generic",
        "url": "https://platform.intabia.ru/_dist",
        "channel": "latest"
      }
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Platform-windows-${version}-${arch}.${ext}",
      "verifyUpdateCodeSignature": false,
      "icon": "./src/AppIcon.ico",
      "publish": {
        "provider": "generic",
        "url": "https://platform.intabia.ru/_dist",
        "channel": "latest"
      },
      "extraResources": [
        {
          "from": "./dist/ui/public/icons/",
          "to": "./icons/",
          "filter": [
            "**/*.ico"
          ]
        }
      ]
    },
    "nsis": {
      "include": "installer.nsh",
      "installerIcon": "./src/AppIcon.ico",
      "uninstallerIcon": "./src/AppIcon.ico"
    },
    "linux": {
      "artifactName": "Platform-linux-${version}-${arch}.${ext}",
      "target": [
        "AppImage",
        "zip"
      ],
      "icon": "./src/AppIcon.png",
      "category": "Utility",
      "publish": {
        "provider": "generic",
        "url": "https://platform.intabia.ru/_dist",
        "channel": "latest"
      }
    }
  },
  "keywords": [
    "electron",
    "typescript",
    "svelte"
  ]
}
