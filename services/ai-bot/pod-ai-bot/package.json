{
  "name": "@hcengineering/pod-ai-bot",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "author": "Hardcore Engineering Inc.",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "test": "jest --passWithNoTests --silent",
    "eval": "ts-node -T src/__tests__/eval/cli.ts",
    "eval:models": "ts-node -T src/__tests__/eval/cli.ts models",
    "eval:check": "ts-node -T src/__tests__/eval/cli.ts check",
    "eval:judge": "ts-node -T src/__tests__/eval/cli.ts judge",
    "_phase:bundle": "pnpm run bundle",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:docker-staging": "pnpm run docker:staging",
    "bundle": "node ../../../common/scripts/esbuild.js --keep-names=true --bundle=true --sourcemap=external --external=*.node --external=bufferutil --external=snappy --external=utf-8-validate --external=msgpackr-extract",
    "docker:build": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_build.sh intabiafusion/ai-bot",
    "docker:staging": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_tag.sh intabiafusion/ai-bot staging",
    "docker:push": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_tag.sh intabiafusion/ai-bot",
    "docker:tbuild": "rush fast-build:bundle --to @hcengineering/pod-ai-bot && docker build -t intabiafusion/ai-bot . --platform=linux/amd64 && ../../../common/scripts/docker_tag_push.sh intabiafusion/ai-bot",
    "format": "format src",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent",
    "_phase:format": "format src"
  },
  "devDependencies": {
    "@hcengineering/platform-rig": "workspace:^0.7.19",
