{
  "name": "@hcengineering/love-agent",
  "version": "0.7.0",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "author": "Anticrm Platform Contributors",
  "license": "EPL-2.0",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run build:wasm && node esbuild.config.js",
    "bundle": "pnpm run build:wasm && node esbuild.config.js",
    "_phase:build": "pnpm run build:wasm && node esbuild.config.js",
    "_phase:bundle": "pnpm run bundle",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:test": "jest --passWithNoTests --silent",
    "docker:build": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_build.sh intabiafusion/love-agent",
    "docker:push": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_tag.sh intabiafusion/love-agent",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --fix src/**/*.ts",
    "format": "prettier --write src/**/*.ts && pnpm run lint:fix && echo 'Formatted'",
    "_phase:format": "pnpm run format",
    "build:wasm": "asc assembly/fft.ts --target release --outFile src/wasm/fft.wasm --optimize --runtime stub",
    "test": "jest --passWithNoTests --coverage",
    "dev": "node esbuild.config.cjs && node bundle/agent.js dev",
    "start": "node bundle/agent.js start",
    "connect": "node esbuild.config.cjs && node bundle/agent.js connect",
    "split-audio": "node esbuild.config.js && node bundle/cli/split-audio.js"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "catalog:",
    "@types/jest": "catalog:",
    "@types/jwt-simple": "^0.5.36",
    "@types/node": "catalog:",
    "@types/uuid": "catalog:",
    "@types/ws": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "assemblyscript": "^0.28.14",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-config-standard": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "ts-jest": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@deepgram/sdk": "^4.11.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@livekit/agents": "^1.7.0",
    "@livekit/rtc-node": "^0.13.34",
    "dotenv": "catalog:",
    "jwt-simple": "catalog:",
    "uuid": "catalog:",
    "ws": "catalog:",
    "zod": "^4.5.4"
  }
}
