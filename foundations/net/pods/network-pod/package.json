{
  "name": "@hcengineering/network-pod",
  "version": "0.7.10",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "author": "Huly Platform Contributors",
  "template": "@hcengineering/node-package",
  "license": "EPL-2.0",
  "files": [
    "lib/**/*",
    "types/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "pnpm --filter @hcengineering/network-pod run bundle && cross-env NODE_ENV=production node --inspect bundle/bundle.js",
    "start-flame": "pnpm --filter @hcengineering/network-pod run bundle && cross-env NODE_ENV=production clinic flame --dest ./out -- node --nolazy -r ts-node/register --enable-source-maps src/__start.ts",
    "start-raw": "ts-node src/__start.ts",
    "dev": "ts-node src/__start.ts",
    "build": "compile",
    "prepublishOnly": "npm run build",
    "_phase:bundle": "echo done",
    "_phase:docker-build": "echo done",
    "_phase:docker-staging": "echo done",
    "bundle": "node ../../../../common/scripts/esbuild.js --entry=src/index.ts --keep-names=true --bundle=true --sourcemap=external --external=*.node --external=zeromq",
    "docker:build": "node ../../../../common/scripts/run_in_bash.js ../../../../common/scripts/docker_build.sh intabiafusion/network-pod",
    "docker:tbuild": "docker build -t intabiafusion/network-pod . --platform=linux/amd64 && ../../../../common/scripts/docker_tag_push.sh intabiafusion/network-pod",
    "docker:abuild": "docker build -t intabiafusion/network-pod . --platform=linux/arm64 && ../../../../common/scripts/docker_tag_push.sh intabiafusion/network-pod",
    "build:watch": "compile",
    "format": "format src",
    "test": "jest --coverage --coverageDirectory=./coverage --passWithNoTests --forceExit",
    "_phase:build": "compile build",
    "_phase:test": "echo done",
    "_phase:format": "format src"
  },
  "devDependencies": {
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint": "catalog:",
    "simplytyped": "^3.3.0",
    "@typescript-eslint/parser": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/uuid": "catalog:",
    "esbuild": "catalog:",
    "ts-node": "catalog:"
  },
  "dependencies": {
    "@hcengineering/network-core": "workspace:^0.7.10",
    "@hcengineering/network-server": "workspace:^0.7.10",
    "uuid": "catalog:"
  },
  "repository": "https://github.com/hcengineering/huly.net",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
