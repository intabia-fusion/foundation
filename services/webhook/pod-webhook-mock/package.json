{
  "name": "@hcengineering/pod-webhook-mock",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "author": "Intabia Fusion",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "test": "jest --passWithNoTests --silent",
    "_phase:bundle": "pnpm run bundle",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:docker-staging": "pnpm run docker:staging",
    "bundle": "node ../../../common/scripts/esbuild.js --keep-names=true --sourcemap=external",
    "docker:build": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_build.sh intabiafusion/webhook-mock",
    "docker:staging": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_tag.sh intabiafusion/webhook-mock staging",
    "docker:abuild": "docker build -t intabiafusion/webhook-mock . --platform=linux/arm64 && ../../../common/scripts/docker_tag_push.sh intabiafusion/webhook-mock",
    "docker:push": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_tag.sh intabiafusion/webhook-mock",
    "run-local": "cross-env ts-node src/index.ts",
    "format": "format src",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent",
    "_phase:format": "format src"
  },
  "devDependencies": {
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@tsconfig/node16": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "cross-env": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-node": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "@types/jest": "catalog:",
    "prettier": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@hcengineering/pod-webhook": "workspace:^0.7.0",
    "@hcengineering/setting": "workspace:^0.7.0",
    "express": "catalog:"
  }
}
