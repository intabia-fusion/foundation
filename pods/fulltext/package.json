{
  "name": "@hcengineering/pod-fulltext",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "author": "Anticrm Platform Contributors",
  "template": "@hcengineering/node-package",
  "license": "EPL-2.0",
  "testIsolated": true,
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "compile",
    "build:watch": "compile",
    "_phase:bundle": "pnpm run bundle",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:docker-staging": "pnpm run docker:staging",
    "get-model": "node ../../common/scripts/esbuild.js --entry=src/get-model.ts --out=get-model-bundle.js --keep-names=true --bundle=true --define=MODEL_VERSION --define=VERSION --define=GIT_REVISION && node ./bundle/get-model-bundle.js > ./bundle/model.json",
    "bundle": "pnpm run get-model && node ../../common/scripts/esbuild.js --keep-names=true --bundle=true --external=snappy --sourcemap=external",
    "docker:build": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_build.sh intabiafusion/fulltext",
    "docker:tbuild": "docker build -t intabiafusion/fulltext . --platform=linux/amd64 && node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag_push.sh intabiafusion/fulltext",
    "docker:abuild": "docker build -t intabiafusion/fulltext . --platform=linux/arm64 && node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag_push.sh intabiafusion/fulltext",
    "docker:staging": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/fulltext staging",
    "docker:push": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/fulltext",
    "format": "format src",
    "test": "jest --passWithNoTests --silent --forceExit",
    "bench": "jest --config jest.bench.config.js --runInBand --forceExit",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent --forceExit",
    "_phase:format": "format src"
  },
  "devDependencies": {
    "cross-env": "catalog:",
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint": "catalog:",
    "esbuild": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "prettier": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "@types/jest": "catalog:",
    "@hcengineering/model-all": "workspace:^0.7.0",
    "@types/koa-bodyparser": "catalog:",
    "@types/koa-router": "catalog:",
    "@types/koa": "catalog:",
    "@types/koa__cors": "catalog:",
    "eslint-config-standard": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "@stylistic/eslint-plugin": "catalog:"
  },
  "dependencies": {
    "@hcengineering/platform": "workspace:^0.7.19",
    "@hcengineering/server-token": "workspace:^0.7.17",
    "@hcengineering/server-core": "workspace:^0.7.18",
    "@hcengineering/server-pipeline": "workspace:^0.7.0",
    "@hcengineering/client": "workspace:^0.7.18",
    "@hcengineering/client-resources": "workspace:^0.7.18",
    "@hcengineering/core": "workspace:^0.7.24",
    "dotenv": "catalog:",
    "@hcengineering/analytics": "workspace:^0.7.17",
    "@hcengineering/analytics-service": "workspace:^0.7.17",
    "koa": "catalog:",
    "koa-router": "catalog:",
    "koa-bodyparser": "catalog:",
    "@koa/cors": "catalog:",
    "@hcengineering/server-indexer": "workspace:^0.7.0",
    "@hcengineering/elastic": "workspace:^0.7.17",
    "@hcengineering/server-collaboration": "workspace:^0.7.0",
    "@hcengineering/middleware": "workspace:^0.7.22",
    "@hcengineering/server-client": "workspace:^0.7.17",
    "@hcengineering/server-storage": "workspace:^0.7.17",
    "@hcengineering/postgres": "workspace:^0.7.22",
    "@hcengineering/kafka": "workspace:^0.7.19",
    "@hcengineering/hulylake-client": "workspace:^0.7.17"
  }
}
