{
  "name": "@hcengineering/pod-collaborator",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "author": "Hardcore Engineering Inc.",
  "template": "@hcengineering/node-package",
  "license": "EPL-2.0",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "_phase:bundle": "pnpm run bundle",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:docker-staging": "pnpm run docker:staging",
    "bundle": "node ../../common/scripts/esbuild.js --entry=src/__start.ts --keep-names=true --sourcemap=external --external=*.node --external=snappy --external=bufferutil",
    "docker:build": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_build.sh intabiafusion/collaborator",
    "docker:tbuild": "docker build -t intabiafusion/collaborator . --platform=linux/amd64 && ../../common/scripts/docker_tag_push.sh intabiafusion/collaborator",
    "docker:abuild": "docker build -t intabiafusion/collaborator . --platform=linux/arm64 && ../../common/scripts/docker_tag_push.sh intabiafusion/collaborator",
    "docker:staging": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/collaborator staging",
    "docker:push": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/collaborator",
    "run-local": "cross-env MONGO_URL=mongodb://localhost:27017 SECRET=secret MINIO_ENDPOINT=localhost MINIO_ACCESS_KEY=minioadmin MINIO_SECRET_KEY=minioadmin ts-node src/__start.ts",
    "format": "format src",
    "test": "jest --passWithNoTests --silent --forceExit",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent --forceExit",
    "_phase:format": "format src"
  },
  "devDependencies": {
    "cross-env": "catalog:",
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint": "catalog:",
    "esbuild": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "prettier": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "@types/jest": "catalog:",
    "eslint-config-standard": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "@stylistic/eslint-plugin": "catalog:"
  },
  "dependencies": {
    "@hcengineering/core": "workspace:^0.7.24",
    "@hcengineering/collaborator": "workspace:^0.7.0",
    "@hcengineering/platform": "workspace:^0.7.19",
    "@hcengineering/analytics": "workspace:^0.7.17",
    "@hcengineering/analytics-service": "workspace:^0.7.17",
    "@hcengineering/server-core": "workspace:^0.7.18"
  }
}
