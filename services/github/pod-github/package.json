    "docker:push": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_tag.sh intabiafusion/github",
    "docker:tbuild": "rush bundle --to @hcengineering/pod-github && docker build -t intabiafusion/github . --platform=linux/amd64 && ../../../common/scripts/docker_tag_push.sh intabiafusion/github",
