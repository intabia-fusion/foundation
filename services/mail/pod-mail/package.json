{
  "name": "@hcengineering/pod-mail",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "author": "Hardcore Engineering Inc.",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "test": "jest --passWithNoTests --silent",
    "_phase:bundle": "pnpm run bundle",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:docker-staging": "pnpm run docker:staging",
    "bundle": "node ../../../common/scripts/esbuild.js --keep-names=true --bundle=true --sourcemap=external --external=*.node --external=bufferutil --external=snappy --external=utf-8-validate --external=msgpackr-extract",
    "docker:build": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_build.sh intabiafusion/mail",
    "docker:staging": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_tag.sh intabiafusion/mail staging",
    "docker:abuild": "docker build -t intabiafusion/mail . --platform=linux/arm64 && ../../../common/scripts/docker_tag_push.sh intabiafusion/mail",
    "docker:push": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_tag.sh intabiafusion/mail",
    "run-local": "ts-node src/index.ts",
    "format": "format src",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent",
    "_phase:format": "format src"
  },
  "devDependencies": {
    "cross-env": "catalog:",
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint": "catalog:",
    "esbuild": "catalog:",
    "prettier": "catalog:",
    "ts-node": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "@types/jest": "catalog:",
    "@tsconfig/node16": "catalog:",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "eslint-plugin-node": "catalog:",
    "typescript": "catalog:",
    "eslint-config-standard": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "@stylistic/eslint-plugin": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1127.0",
    "@types/nodemailer": "^6.4.17",
    "@hcengineering/analytics": "workspace:^0.7.17",
    "@hcengineering/analytics-service": "workspace:^0.7.17",
    "@hcengineering/core": "workspace:^0.7.24",
    "@hcengineering/server-core": "workspace:^0.7.18",
    "@hcengineering/server-client": "workspace:^0.7.17",
    "@hcengineering/kafka": "workspace:^0.7.19",
    "@intabiafusion/clisr": "workspace:^0.7.0",
    "cors": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:",
    "lru-cache": "catalog:",
    "nodemailer": "^6.10.0"
  }
}
