{
  "name": "@hcengineering/core",
  "version": "0.7.25",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "files": [
    "lib/**/*",
    "!lib/**/__test__/**",
    "types/**/*",
    "!types/**/__test__/**",
    "src/**/*",
    "!src/**/__test__/**",
    "lang/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "author": "Anticrm Platform Contributors",
  "license": "EPL-2.0",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "test": "jest --passWithNoTests --silent --coverage",
    "format": "format src",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent --coverage",
    "_phase:format": "format src"
  },
  "devDependencies": {
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "eslint-config-standard": "catalog:",
    "@stylistic/eslint-plugin": "catalog:"
  },
  "dependencies": {
    "@hcengineering/platform": "workspace:^0.7.19",
    "@hcengineering/analytics": "workspace:^0.7.17",
    "@hcengineering/measurements": "workspace:^0.7.18",
    "fast-equals": "catalog:"
  },
  "repository": "https://github.com/hcengineering/huly.core",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./lib/index.js",
      "import": "./lib/index.js"
    },
    "./lang/*.json": {
      "require": "./lang/*.json",
      "import": "./lang/*.json"
    },
    "./lang": {
      "require": "./lang",
      "import": "./lang"
    }
  }
}
