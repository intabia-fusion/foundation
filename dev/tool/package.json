  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "start": "ts-node src/__start.ts",
    "_phase:bundle": "pnpm run bundle",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:docker-staging": "pnpm run docker:staging",
    "bundle": "node ../../common/scripts/esbuild.js --entry=src/__start.ts --keep-names=true --external=snappy --sourcemap=external --define:MODEL_VERSION --define:GIT_REVISION",
    "docker:build": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_build.sh intabiafusion/tool",
    "docker:tbuild": "docker build -t intabiafusion/tool . --platform=linux/amd64 && node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag_push.sh intabiafusion/tool",
    "docker:abuild": "docker build -t intabiafusion/tool . --platform=linux/arm64 && node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag_push.sh intabiafusion/tool",
    "docker:staging": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/tool staging",
    "docker:push": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/tool",
    "run-local": "(pnpm -w bundle --to @hcengineering/tool >/dev/null || true) && cross-env SERVER_SECRET=secret FULLTEXT_URL=http://localhost:8087/_fulltext ACCOUNTS_URL=http://localhost:8087/_account REGION_CONFIG_JSON='{\"regions\":{\"\":{\"transactors\":[{\"external\":\"ws://localhost:8087/_tr\",\"internal\":\"ws://localhost:8087/_tr\"}],\"collaborators\":[{\"external\":\"ws://localhost:8087/_cl\",\"internal\":\"ws://localhost:8087/_cl\"}]}}}' STORAGE_CONFIG='datalake|http://localhost:8087/_datalake' HULYLAKE_URL=http://localhost:8087/_love STATS_URL=http://localhost:8087/_stats ACCOUNT_DB_URL=postgresql://postgres:postgres@localhost:5432 DB_URL=postgresql://postgres:postgres@localhost:5432 TELEGRAM_DATABASE=telegram-service REKONI_URL=http://localhost:8087/_rekoni REGION_INFO='cockroach|CockroachDB' MODEL_VERSION=$(node ../../common/scripts/show_version.js) GIT_REVISION=$(git describe --all --long) QUEUE_CONFIG='localhost:19092' node --expose-gc --max-old-space-size=18000 $TOOL_OPT ./bundle/bundle.js",
    "runl": "cross-env SERVER_SECRET=secret FULLTEXT_URL=http://localhost:8087/_fulltext ACCOUNTS_URL=http://localhost:8087/_account REGION_CONFIG_JSON='{\"regions\":{\"\":{\"transactors\":[{\"external\":\"ws://localhost:8087/_tr\",\"internal\":\"ws://localhost:8087/_tr\"}],\"collaborators\":[{\"external\":\"ws://localhost:8087/_cl\",\"internal\":\"ws://localhost:8087/_cl\"}]}}}' STORAGE_CONFIG='datalake|http://localhost:8087/_datalake' HULYLAKE_URL=http://localhost:8087/_love STATS_URL=http://localhost:8087/_stats ACCOUNT_DB_URL=postgresql://postgres:postgres@localhost:5432 DB_URL=postgresql://postgres:postgres@localhost:5432 TELEGRAM_DATABASE=telegram-service REKONI_URL=http://localhost:8087/_rekoni REGION_INFO='cockroach|CockroachDB' MODEL_VERSION=$(node ../../common/scripts/show_version.js) GIT_REVISION=$(git describe --all --long) QUEUE_CONFIG='localhost:19092' node $TOOL_OPT ./bundle/bundle.js",
    "run": "(pnpm -w bundle --to @hcengineering/tool >/dev/null || true ) && cross-env node --max-old-space-size=8000 ./bundle/bundle.js",
    "runn": "cross-env  MODEL_VERSION=$(node ../../common/scripts/show_version.js) GIT_REVISION=$(git describe --all --long) node --max-old-space-size=8000 $TOOL_OPT ./bundle/bundle.js",
    "upgrade-mongo": "pnpm run run-local-mongo upgrade-workspace -- $1",
    "upgrade": "pnpm run run-local upgrade-workspace -- $1",
    "upgrade-brk": "pnpm run run-local-brk upgrade-workspace -- $1",
    "dump-indexes": "pnpm run run-local dump-indexes -- $1",
    "sync-indexes": "pnpm run run-local sync-indexes -- $1",
    "sync-indexes-apply": "pnpm run run-local sync-indexes -- $1 --apply",
    "format": "format src",
    "test": "jest --passWithNoTests --silent --forceExit",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent --forceExit",
    "_phase:format": "format src"
  },
