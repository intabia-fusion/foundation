{
  "name": "@hcengineering/love-agent",
  "version": "0.7.0",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "author": "Anticrm Platform Contributors",
  "license": "EPL-2.0",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "type": "module",
  "scripts": {
    "build": "rushx build:wasm && node esbuild.config.js",
    "bundle": "rushx build:wasm && node esbuild.config.js",
    "_phase:build": "rushx build:wasm && node esbuild.config.js",
    "_phase:bundle": "rushx bundle",
    "_phase:docker-build": "rushx docker:build",
    "_phase:test": "jest --passWithNoTests --silent",
    "docker:build": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_build.sh intabiafusion/love-agent",
    "docker:push": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_tag.sh intabiafusion/love-agent",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --fix src/**/*.ts",
    "format": "prettier --write src/**/*.ts && rushx lint:fix && echo 'Formatted'",
    "_phase:format": "rushx format",
    "build:wasm": "asc assembly/fft.ts --target release --outFile src/wasm/fft.wasm --optimize --runtime stub",
    "test": "jest --passWithNoTests --coverage",
    "dev": "node esbuild.config.cjs && node bundle/agent.js dev",
    "start": "node bundle/agent.js start",
    "connect": "node esbuild.config.cjs && node bundle/agent.js connect",
    "split-audio": "node esbuild.config.js && node bundle/cli/split-audio.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/jwt-simple": "^0.5.36",
    "@types/node": "^24.13.3",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "assemblyscript": "^0.28.14",
    "esbuild": "^0.25.10",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-standard-with-typescript": "^40.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^15.4.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@deepgram/sdk": "^4.11.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@livekit/agents": "^1.7.0",
    "@livekit/rtc-node": "^0.13.34",
    "dotenv": "^16.6.1",
    "jwt-simple": "^0.5.6",
    "uuid": "^11.1.1",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  }
}
