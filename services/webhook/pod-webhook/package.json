{
  "name": "@hcengineering/pod-webhook",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "author": "Intabia Fusion",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "test": "jest --passWithNoTests --silent",
    "_phase:bundle": "pnpm run bundle",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:docker-staging": "pnpm run docker:staging",
    "bundle": "node ../../../common/scripts/esbuild.js --keep-names=true --sourcemap=external",
    "docker:build": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_build.sh intabiafusion/webhook",
    "docker:staging": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_tag.sh intabiafusion/webhook staging",
    "docker:abuild": "docker build -t intabiafusion/webhook . --platform=linux/arm64 && ../../../common/scripts/docker_tag_push.sh intabiafusion/webhook",
    "docker:push": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_tag.sh intabiafusion/webhook",
    "run-local": "cross-env ts-node src/index.ts",
    "format": "format src",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent",
    "_phase:format": "format src"
  },
  "devDependencies": {
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@tsconfig/node16": "^16.1.9",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "cross-env": "~7.0.3",
    "esbuild": "^0.25.10",
    "eslint": "^8.54.0",
    "eslint-config-standard-with-typescript": "^40.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^15.4.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.5",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hcengineering/kafka": "workspace:^0.7.19",
    "@hcengineering/analytics": "workspace:^0.7.17",
    "@hcengineering/analytics-service": "workspace:^0.7.17",
    "@hcengineering/server-token": "workspace:^0.7.17",
    "@hcengineering/server-core": "workspace:^0.7.18",
    "@hcengineering/rpc": "workspace:^0.7.17",
    "@hcengineering/core": "workspace:^0.7.24",
    "@hcengineering/account-client": "workspace:^0.7.21",
    "@hcengineering/platform": "workspace:^0.7.19",
    "@hcengineering/api-client": "workspace:^0.7.18",
    "@hcengineering/chunter": "workspace:^0.7.0",
    "@hcengineering/contact": "workspace:^0.7.0",
    "@hcengineering/document": "workspace:^0.7.0",
    "@hcengineering/setting": "workspace:^0.7.0",
    "@hcengineering/task": "workspace:^0.7.0",
    "@hcengineering/tracker": "workspace:^0.7.0",
    "@hcengineering/text-core": "workspace:^0.7.18",
    "@hcengineering/text-markdown": "workspace:^0.7.20",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2"
  }
