{
  "name": "@hcengineering/pod-db-migrator",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "author": "Copyright \u00a9 2026 Intabia Fusion.",
  "template": "@hcengineering/node-package",
  "license": "EPL-2.0",
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "compile",
    "build:watch": "compile",
    "_phase:bundle": "pnpm run bundle",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:docker-staging": "pnpm run docker:staging",
    "bundle": "node ../../common/scripts/esbuild.js --entry=./src/index.ts --keep-names=true --bundle=true --external=*.node --external=snappy --sourcemap=external",
    "docker:build": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_build.sh intabiafusion/db-migrator .",
    "docker:tbuild": "docker build -t intabiafusion/db-migrator . --platform=linux/amd64 && ../../common/scripts/docker_tag_push.sh intabiafusion/db-migrator",
    "docker:abuild": "docker build -t intabiafusion/db-migrator . --platform=linux/arm64 && ../../common/scripts/docker_tag_push.sh intabiafusion/db-migrator",
    "docker:staging": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/db-migrator staging",
    "docker:push": "node ../../common/scripts/run_in_bash.js ../../common/scripts/docker_tag.sh intabiafusion/db-migrator",
    "format": "format src",
    "test": "jest --passWithNoTests --silent --forceExit",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent --forceExit",
    "_phase:format": "format src"
  },
  "devDependencies": {
    "@hcengineering/platform-rig": "workspace:^0.7.19",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "cross-env": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "ts-jest": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "eslint-config-standard": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "@stylistic/eslint-plugin": "catalog:"
  },
  "dependencies": {
    "@hcengineering/analytics": "workspace:^0.7.17",
    "@hcengineering/analytics-service": "workspace:^0.7.17",
    "@hcengineering/core": "workspace:^0.7.24",
    "@hcengineering/platform": "workspace:^0.7.19",
    "@hcengineering/postgres": "workspace:^0.7.22",
    "@hcengineering/retry": "workspace:^0.7.17",
    "@hcengineering/server-core": "workspace:^0.7.18",
    "@hcengineering/server-token": "workspace:^0.7.17",
    "dotenv": "catalog:",
    "postgres": "catalog:"
  }
}
