{
  "name": "@hcengineering/pod-export",
  "version": "0.7.0",
  "main": "lib/index.js",
  "svelte": "src/index.ts",
  "types": "types/index.d.ts",
  "files": [
    "lib/**/*",
    "types/**/*",
    "tsconfig.json"
  ],
  "author": "Hardcore Engineering Inc.",
  "scripts": {
    "build": "compile",
    "build:watch": "compile",
    "test": "jest --passWithNoTests --silent",
    "_phase:bundle": "pnpm run bundle",
    "_phase:docker-build": "pnpm run docker:build",
    "_phase:docker-staging": "pnpm run docker:staging",
    "bundle": "node ../../../common/scripts/esbuild.js --keep-names=true",
    "docker:build": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_build.sh intabiafusion/export",
    "docker:tbuild": "docker build -t intabiafusion/export . --platform=linux/amd64 && ../../../common/scripts/docker_tag_push.sh intabiafusion/export",
    "docker:abuild": "docker build -t intabiafusion/export . --platform=linux/arm64 && ../../../common/scripts/docker_tag_push.sh intabiafusion/export",
    "docker:staging": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_tag.sh intabiafusion/export staging",
    "docker:push": "node ../../../common/scripts/run_in_bash.js ../../../common/scripts/docker_tag.sh intabiafusion/export",
    "format": "format src",
    "run-local": "cross-env ts-node src/index.ts",
    "_phase:build": "compile build",
    "_phase:test": "jest --passWithNoTests --silent",
    "_phase:format": "format src"
  },
